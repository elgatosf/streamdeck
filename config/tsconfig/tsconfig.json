{
    "compilerOptions": {
        /* Type checking */
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,

        /* Modules */
        "rootDir": "${configDir}/src",
        "resolveJsonModule": true,

        /* JavaScript support */
        "allowJs": true,

        /* Interop constraints */
        "esModuleInterop": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,

        /* Completeness */
        "skipLibCheck": true
    },
    "include": ["${configDir}/src"]
}
