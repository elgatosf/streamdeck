{
    "compilerOptions": {
        /* Type checking */
        "strict": true,
        // TODO: "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,

        /* Modules */
        "module": "nodenext",
        "resolveJsonModule": true,

        /* JavaScript support */
        "allowJs": true,

        /* Interop constraints */
        "esModuleInterop": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,

        /* Completeness */
        "skipLibCheck": true
    }
}
