{
    "name": "@elgato/example-image-resizer",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.elgato.image-resizer\"",
        "postinstall": "pnpm --dir com.elgato.image-resizer.sdPlugin install --frozen-lockfile"
    },
    "dependencies": {
        "@elgato/streamdeck": "^3.0.4",
        "sharp": "^0.34.5"
    },
    "devDependencies": {
        "@elgato/cli": "^1.10.4",
        "@rollup/plugin-commonjs": "^28.0.0",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "~20.15.0",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "typescript": "^5.2.2"
    },
    "packageManager": "pnpm@10.18.0"
}
