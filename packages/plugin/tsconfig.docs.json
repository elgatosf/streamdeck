{
    "compilerOptions": {
        "customConditions": ["node"],
        "esModuleInterop": true,
        "lib": ["es2023", "esnext.disposable"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noImplicitOverride": true,
        "paths": {
            "@elgato/streamdeck": ["./src/plugin/index.ts"]
        },
        "skipLibCheck": true,
        "strict": true,
        "target": "esnext",
        "types": ["node"]
    }
}
