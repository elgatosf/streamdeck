{
    "name": "@elgato/streamdeck",
    "version": "3.0.4",
    "description": "The official Node.js SDK for creating Stream Deck plugins.",
    "keywords": [
        "elgato",
        "framework",
        "maker",
        "marketplace",
        "plugin",
        "sdk",
        "stream deck"
    ],
    "homepage": "https://github.com/elgatosf/streamdeck#readme",
    "bugs": {
        "url": "https://github.com/elgatosf/streamdeck/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Elgato",
        "url": "https://www.elgato.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/elgatosf/streamdeck.git"
    },
    "files": [
        "./dist/**/*.{d.ts,js}",
        "./docs",
        "./AGENTS.md"
    ],
    "type": "module",
    "main": "./dist/plugin/index.js",
    "types": "./dist/plugin/index.d.ts",
    "exports": "./dist/plugin/index.js",
    "scripts": {
        "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
        "dev": "rm -rf ./dist && tsc -p tsconfig.build.json -w",
        "docs:check": "tsc -p tsconfig.scripts.json && node scripts/check-docs.ts",
        "docs:generate": "tsx scripts/docs/generate.ts",
        "lint": "eslint --max-warnings 0",
        "test": "vitest --run --reporter verbose",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "prepack": "cp ../../README.md . && cp ../../LICENSE . && pnpm run docs:generate && rm -rf docs && cp -R ../../docs/sdk docs"
    },
    "dependencies": {
        "@elgato/schemas": "workspace:*",
        "@elgato/utils": "workspace:*",
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "@elgato/eslint-config": "^0.3.2",
        "@elgato/markdown": "workspace:^",
        "@elgato/tsconfig": "workspace:^",
        "@types/ejs": "^3.1.5",
        "@types/markdown-it": "^14.2.0",
        "@types/node": "^24.12.0",
        "@types/ws": "^8.18.1",
        "@vitest/coverage-v8": "^3.2.4",
        "ejs": "^7.0.2",
        "eslint": "^9.39.4",
        "markdown-it": "^15.0.3",
        "mock-socket": "^9.3.1",
        "oxfmt": "^0.70.0",
        "ts-morph": "^28.0.0",
        "tslib": "^2.8.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4",
        "vitest-websocket-mock": "^0.5.0"
    },
    "engines": {
        "node": ">=20.5.1"
    }
}
