{
    "name": "@elgato/streamdeck",
    "version": "3.0.2",
    "description": "The official Node.js SDK for creating Stream Deck plugins.",
    "keywords": [
        "elgato",
        "framework",
        "maker",
        "marketplace",
        "plugin",
        "sdk",
        "stream deck"
    ],
    "homepage": "https://github.com/elgatosf/streamdeck#readme",
    "bugs": {
        "url": "https://github.com/elgatosf/streamdeck/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Elgato",
        "url": "https://www.elgato.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/elgatosf/streamdeck.git"
    },
    "files": [
        "./dist/**/*.js",
        "./dist/**/*.d.ts"
    ],
    "type": "module",
    "main": "./dist/plugin/index.js",
    "types": "./dist/plugin/index.d.ts",
    "exports": "./dist/plugin/index.js",
    "scripts": {
        "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
        "dev": "rm -rf ./dist && tsc -p tsconfig.build.json -w",
        "docs:generate": "tsx scripts/docs/generate.ts",
        "docs:check": "tsx scripts/docs/generate.ts --check && tsx scripts/docs/validate.ts && markdownlint-cli2 && tsc && tsc -p docs/_snippets/node/tsconfig.json && tsc -p docs/_snippets/browser/tsconfig.json",
        "lint": "eslint --max-warnings 0",
        "test": "vitest --run --reporter verbose",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "prepack": "cp ../../README.md . && cp ../../LICENSE ."
    },
    "dependencies": {
        "@elgato/schemas": "workspace:*",
        "@elgato/utils": "workspace:*",
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "@elgato/eslint-config": "^0.3.2",
        "@tsconfig/node20": "^20.1.9",
        "@types/node": "^24.12.0",
        "@types/ws": "^8.18.1",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.39.4",
        "markdownlint-cli2": "^0.23.3",
        "mock-socket": "^9.3.1",
        "oxfmt": "^0.70.0",
        "ts-morph": "^28.0.0",
        "tslib": "^2.8.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4",
        "vitest-websocket-mock": "^0.5.0",
        "zod": "^3.25.76"
    },
    "engines": {
        "node": ">=20.5.1"
    }
}
