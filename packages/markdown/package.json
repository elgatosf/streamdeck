{
    "name": "@elgato/markdown",
    "private": true,
    "description": "Tools for working with markdown files.",
    "keywords": [
        "elgato",
        "markdown",
        "template",
        "type check"
    ],
    "homepage": "https://github.com/elgatosf/streamdeck/tree/main/packages/md-tools#readme",
    "bugs": {
        "url": "https://github.com/elgatosf/streamdeck/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Elgato",
        "url": "https://www.elgato.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/elgatosf/streamdeck.git"
    },
    "files": [
        "./dist/**/*.{d.ts,js}"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "dev": "tsc --project tsconfig.build.json --watch",
        "lint": "eslint --max-warnings 0",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest --typecheck",
        "type:check": "tsc",
        "prepack": "cp ../../LICENSE ."
    },
    "dependencies": {
        "remark": "^15.0.1",
        "remark-mdx": "^3.1.1",
        "remark-parse": "^11.0.0",
        "unified": "^11.0.5"
    },
    "devDependencies": {
        "@elgato/eslint-config": "^0.3.2",
        "@elgato/tsconfig": "workspace:^",
        "@types/mdast": "^4.0.4",
        "@types/node": "^24.0.0",
        "@types/unist": "^3.0.3",
        "@vitest/coverage-v8": "^3.1.4",
        "eslint": "^9.39.4",
        "typescript": "^5.8.3",
        "vitest": "^3.1.3"
    },
    "peerDependencies": {
        "typescript": "^5.8.3"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
