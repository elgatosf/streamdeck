{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["bin/**", "dist/**", "*.sdPlugin/bin/**"]
        },
        "@elgato/cli#build": {
            "dependsOn": ["^build", "@elgato/docs#build"],
            "outputs": ["bin/**", "dist/**"]
        },
        "@elgato/streamdeck#build": {
            "dependsOn": ["^build", "@elgato/docs#build"],
            "outputs": ["dist/**"]
        },
        "@elgato/schemas#build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "streamdeck/**"]
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "lint": {},
        "test": {
            "outputs": ["coverage/**"]
        },
        "test:coverage": {
            "outputs": ["coverage/**"]
        },
        "test:watch": {
            "cache": false,
            "interactive": true,
            "persistent": true
        }
    }
}
